# 测试产出（每个项目独立，不提交到仓库）
output/*
!output/.gitkeep
!output/README.md
!output/archive/
output/archive/*
!output/archive/.gitkeep

# 项目资料（每个项目独立，不提交到仓库）
materials/*
!materials/README.md

# 系统文件
.DS_Store
Thumbs.db
*.swp
*.swo
.obsidian/
.claude/

# 项目配置（真实值不入库，仅 .example 模板入库）
config/accounts.yaml
config/target.yaml
config/signer.yaml

# 用例库：项目专属用例含真实参数，不入库；_baseline 通用集与模板入库
cases/*
!cases/_baseline/
!cases/000-template.yaml

# 签名密钥（从前端 JS 提取，按项目，不入库）
materials/keys/

# Python
__pycache__/
*.pyc
