# 目标配置模板 —— 复制为 config/target.yaml 并填入（不入库）
# Agent 启动时读取，确定测试范围与红线

target:
  name: "<项目名称>"
  base_url: "https://example.com"
  api_prefix: "/api"                 # 接口前缀，如 /api/v1
  scope:                              # 测试范围
    - web
    - api
    - mini_program
    - admin
  excluded_paths: []                  # 排除路径
  test_window: ""                     # 测试时间窗口（可选）

# ── 红线（与 SKILL.md §9 一致，Agent 须遵守）──────────
redlines:
  max_rate: "1/5s"                     # 全局限速 1 请求/5 秒
  no_dos: true
  no_data_destruction: true
  no_real_money: true
  no_sms_bombing: true
  no_brute_force: true                # 大规模字典暴破须额外授权
  write_ops_require_confirmation: true

# ── 授权 ───────────────────────────────────────────────
authorization:
  obtained: false                     # 必须为 true 才执行测试
  method: "书面授权"                   # 书面/邮件/其他
  contact: "<应急联系人>"

# ── 模式 ───────────────────────────────────────────────
# Agent 仍会扫描 materials/ 自动判定；此字段供记录
mode: graybox                         # graybox / blackbox（自动判定，仅记录）
